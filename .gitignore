.env
.env.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# capacitor / mobile build
/.api-stash/
/android/app/build/
/android/build/
/android/.gradle/
/android/local.properties
/android/app/release/
*.keystore
*.jks
.tsumugi-gen.json

