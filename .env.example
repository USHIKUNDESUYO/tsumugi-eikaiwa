# OpenAI Compatible API Configuration (Optional)
# Without these, the app will use simple mock responses
# このアプリはAI佐藤さんと同じDeepSeek接続を使用します
# DeepSeek API Key: https://platform.deepseek.com/api_keys

OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# Cloud TTS Configuration (Optional)
# If not set, falls back to device TTS (browser SpeechSynthesis)
# For OpenAI TTS, use the same key as OPENAI_API_KEY
# Note: DeepSeek does NOT support TTS - use OpenAI or compatible service

TTS_API_KEY=your_openai_api_key_for_tts
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=nova
